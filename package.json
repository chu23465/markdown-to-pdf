{
  "name": "markdowntopdf",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.19.21",
    "gts": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "devDebug": "gts fix && bun run ./debug.html",
    "debugBundle": "bun build --keep-names --target=browser --format=cjs --reject-unresolved --outfile=./build/index.js ./index.ts",
    "bundle": "gts fix && bun run make.ts && tsc --noEmit && bun build --production --minify --outfile=./build/index.js ./index.ts",
    "anotherBundle": "bun build --target=browser --production --minify --outdir=./build2/ debug.html",
    "prodTest": "bun run bundle && bun run ./build/index.html",
    "lint": "gts lint",
    "clean": "gts clean",
    "precompile": "gts fix",
    "compile": "tsc",
    "makeExe": "bun run bundle && bun run makevfs.ts && bun build ./server.ts --compile --outfile ./build/static",
    "fix": "gts fix",
    "prepare": "bun run compile",
    "pretest": "bun run compile",
    "posttest": "bun run lint",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "dependencies": {
    "@nick/comrak": "npm:@jsr/nick__comrak@^0.48.0-rc.0"
  }
}
