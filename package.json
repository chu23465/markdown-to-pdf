{
  "name": "markdowntopdf",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.19.21",
    "gts": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "devDebug": "gts fix && bun run ./debug.html",
    "bundle": "rm -f ./build/index.js && gts fix && tsc --noEmit && bun build --production --outfile=./build/index.js ./index.ts",
    "prodTest": "bun run compile && bun run ./build/index.html",
    "lint": "gts lint",
    "clean": "gts clean",
    "precompile": "gts fix",
    "compile": "tsc",
    "fix": "gts fix",
    "prepare": "bun run compile",
    "pretest": "bun run compile",
    "posttest": "bun run lint",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "dependencies": {
    "@nick/comrak": "npm:@jsr/nick__comrak@^0.48.0-rc.0"
  }
}
